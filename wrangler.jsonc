{
  // Cloudflare Workers static-asset deployment for the participant site.
  //
  // Cloudflare merged Pages into Workers, so the build output directory is no
  // longer a dashboard field -- it lives here. The Workers Builds pipeline runs
  // the build command first, then `wrangler deploy`, which reads this file.
  //
  // There is no `main` entry: this is an assets-only Worker. Nothing runs
  // server-side here. The API lives in Supabase Edge Functions.
  // The deployed URL is <name>.<account-subdomain>.workers.dev. Unlike Pages'
  // globally unique *.pages.dev subdomains, this is scoped to the account, so
  // an unrelated project already using "matching" elsewhere does not clash.
  "name": "matching",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./apps/web/dist",
    // The app is a client-side router (createBrowserRouter in main.tsx), so a
    // hard refresh on /admin or /result must still serve index.html instead of
    // 404ing. This is the Workers equivalent of apps/web/public/_redirects,
    // which only Pages honours.
    "not_found_handling": "single-page-application"
  }
}
